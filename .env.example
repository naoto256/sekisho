# Copy this file to `.env` before `docker compose up`.
#
#   cp .env.example .env
#   openssl rand -hex 32 | sudo install -o root -g 65532 -m 0440 \
#     /dev/stdin /absolute/path/to/sekisho-master-key
#
# `.env` is gitignored. Never commit real secrets.

# ---- Required (single-node and HA) ---------------------------------------
#
# Path to a 32-byte hex (64 chars) credential file. The file wraps every
# per-record DEK; losing it = data loss. Keep it outside the data volume.
# Rootless or userns-remapped Docker requires equivalent read access for the
# image's mapped gid 65532; do not make the credential world-readable.
SEKISHO_MASTER_KEY_FILE=/absolute/path/to/sekisho-master-key

# ---- HA only -------------------------------------------------------------
#
# Single-node deployments use a local SQLite file and need none of the
# variables below. Uncomment them only when you move to a multi-peer
# setup backed by a shared Postgres.
#
# Postgres password used by both the `postgres` and `sekishod` services.
#POSTGRES_PASSWORD=replace-with-a-strong-password
