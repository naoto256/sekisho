[Unit]
Description=Sekisho Web Admin UI (BFF)
Documentation=https://github.com/naoto256/sekisho
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sekisho
Group=sekisho
ExecStart=/usr/bin/sekisho-webui --config /etc/sekisho-webui/webui.yaml
Restart=on-failure
RestartSec=5

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

# sekisho-webui needs to talk to the control socket at /run/sekisho/control.sock
# when auth.local_auth is configured. The sekishod.service RuntimeDirectory
# creates /run/sekisho owned by sekisho:sekisho, and we share it.
# /etc/sekisho-webui is read-only — the optional tls cert/key files live there too.
ReadOnlyPaths=-/run/sekisho /etc/sekisho-webui

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sekisho-webui

[Install]
# Disabled by default; operators opt in per host.
WantedBy=multi-user.target
